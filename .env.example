# Copiar este archivo a `.env` y completar los valores.
# El archivo `.env` NUNCA se sube al repositorio (está en .gitignore).

# --- Base de datos (PostgreSQL + PostGIS) ---
POSTGRES_DB=terrashift
POSTGRES_USER=terrashift
POSTGRES_PASSWORD=cambiar_esta_clave

# --- NASA Earthdata (SMAP, Landsat/MODIS) ---
# Crear cuenta gratuita en https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Zona piloto ---
# Formato: min_lon,min_lat,max_lon,max_lat
# VALOR DE EJEMPLO en el norte del Corredor Seco: reemplazar por la zona piloto real.
PILOT_ZONE_BBOX=-86.70,13.40,-86.50,13.60

# --- Rango temporal de ingesta (NASA POWER) ---
ETL_START_DATE=2015-04-01
ETL_END_DATE=2025-12-31
